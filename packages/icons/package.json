{
  "name": "@word-lock/icons",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Shared SVG icon primitives and the icon set built on them, resolved per platform via .web.tsx/.native.tsx — see src/primitives.web.tsx and src/primitives.native.tsx.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@word-lock/core": "*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native-svg": "^15.14.0",
    "vitest": "^3.2.4"
  }
}
