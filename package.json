{
  "name": "word-lock-monorepo",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@word-lock/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "node scripts/check-boundaries.mjs && eslint .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "deploy": "npm run deploy --workspace @word-lock/web",
    "preview": "npm run preview --workspace @word-lock/web",
    "db:types": "supabase gen types typescript --project-id falecdhgmzmnoryremus > packages/core/src/db/types.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.5",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.7.3",
    "turbo": "^2.5.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=20"
  }
}
