{
  "name": "@word-lock/core",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Platform-agnostic game and account logic shared by the web and mobile clients. Zero runtime dependencies, by design — see src/index.ts.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./game": "./src/game/index.ts",
    "./account": "./src/account/index.ts",
    "./app": "./src/app/index.ts",
    "./auth": "./src/auth/index.ts",
    "./db": "./src/db/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^3.2.4"
  }
}
